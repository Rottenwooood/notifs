{
  "name": "notifs",
  "version": "0.1.2",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/main.ts",
    "start": "bash tools/run.sh",
    "cli": "tsx apps/cli/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node tools/build.mjs",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@notify-hub/channels": "workspace:*",
    "@notify-hub/contracts": "workspace:*",
    "@notify-hub/core": "workspace:*",
    "@notify-hub/producers": "workspace:*",
    "@notify-hub/store": "workspace:*",
    "@notify-hub/supervisor": "workspace:*",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "esbuild": "^0.28.2"
  },
  "bin": {
    "notifs": "./dist/cli.mjs"
  },
  "description": "A tiny local notification relay for agents, scripts and humans.",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rottenwooood/notifs.git"
  },
  "homepage": "https://github.com/Rottenwooood/notifs#readme",
  "bugs": {
    "url": "https://github.com/Rottenwooood/notifs/issues"
  },
  "keywords": [
    "notifications",
    "mcp",
    "agents",
    "feishu",
    "cli",
    "self-hosted",
    "sqlite"
  ]
}
