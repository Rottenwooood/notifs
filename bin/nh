#!/usr/bin/env bash
# notify-hub 命令行入口（省掉 pnpm cli 前缀）
#
#   nh start            启动中心（等价于 tools/run.sh）
#   nh <分组> <动作>     其余都转给 CLI（源/出口/规则/监控程序/凭据/备份…）
#   nh                  打印完整命令表
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$ROOT"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

ENV_FILE="${NOTIFY_ENV_FILE:-$HOME/.config/notify-hub/env}"
if [ ! -f "$ENV_FILE" ] && [ -f "$HOME/.config/notifs/env" ]; then
  ENV_FILE="$HOME/.config/notifs/env"
fi
if [ -f "$ENV_FILE" ]; then
  set -a
  . "$ENV_FILE"
  set +a
fi

# 仓库开发版：显式钉住仓库内的路径（新装走 XDG 默认值）
export NOTIFY_DATA_DIR="${NOTIFY_DATA_DIR:-$ROOT/data}"
export NOTIFY_DB="${NOTIFY_DB:-$NOTIFY_DATA_DIR/notify-hub.db}"
export NOTIFY_PRODUCERS_DIR="${NOTIFY_PRODUCERS_DIR:-$ROOT/producers}"

case "${1:-}" in
  start|serve)
    shift
    exec "$ROOT/tools/run.sh" "$@"
    ;;
  *)
    exec node --import tsx apps/cli/src/main.ts "$@"
    ;;
esac
