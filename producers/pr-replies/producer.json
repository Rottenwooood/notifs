{
  "name": "PR 回复监控",
  "slug": "pr-replies",
  "kind": "managed",
  "description": "轮询一个 GitHub PR 的新回复（会话评论 / 代码行评论 / 正式 review），过滤机器人与自己后上报事件。",
  "enabled": false,
  "interval": "120s",
  "credentials": [],
  "command": ["node", "index.mjs"],
  "config": {
    "repo": "harbor-framework/terminal-bench-science",
    "pr": 2128,
    "apiBase": "https://api.github.com",
    "intervalSeconds": 120
  }
}
